# Ключ используется только сервером. Запросы к OpenAI оплачиваются отдельно.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-transcribe
SUMMARY_MODEL=gpt-4.1-mini
PORT=3030
# Пути нужны, только если программы отсутствуют в PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Относительно папки приложения; каталог должен принадлежать только приложению.
DATA_DIR=./data
# Локальная расшифровка: сначала npm run setup:local. По умолчанию CPU, 2 потока.
LOCAL_THREADS=2
# Необязательно: пути к другому Python и каталогу установленной модели.
# LOCAL_PYTHON=C:/Projects/meeting-notes/.venv-local/Scripts/python.exe
# LOCAL_MODEL_DIR=./models/sherpa-onnx-nemo-transducer-punct-giga-am-v3-russian-2025-12-16
# DIARIZATION_MODEL_DIR=./models/diarization
